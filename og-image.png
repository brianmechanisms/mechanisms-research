<!-- This would be a PNG file, but I'll create an SVG that can be converted -->
<svg width="1200" height="630" viewBox="0 0 1200 630" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background gradient -->
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#1e293b"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#bg)"/>
  
  <!-- Grid pattern -->
  <defs>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#334155" stroke-width="0.5" opacity="0.3"/>
    </pattern>
  </defs>
  <rect width="1200" height="630" fill="url(#grid)"/>
  
  <!-- Main content -->
  <g transform="translate(100, 100)">
    <!-- Large gear mechanism -->
    <g transform="translate(150, 200)">
      <!-- Main gear -->
      <circle cx="0" cy="0" r="80" fill="#64748b" stroke="#3b82f6" stroke-width="4"/>
      <!-- Gear teeth -->
      <g stroke="#3b82f6" stroke-width="3" fill="#3b82f6">
        <rect x="-10" y="-85" width="20" height="10"/>
        <rect x="-10" y="75" width="20" height="10"/>
        <rect x="-85" y="-10" width="10" height="20"/>
        <rect x="75" y="-10" width="10" height="20"/>
        <rect x="-65" y="-55" width="15" height="8" transform="rotate(45)"/>
        <rect x="50" y="47" width="15" height="8" transform="rotate(45)"/>
        <rect x="50" y="-55" width="15" height="8" transform="rotate(-45)"/>
        <rect x="-65" y="47" width="15" height="8" transform="rotate(-45)"/>
      </g>
      <circle cx="0" cy="0" r="20" fill="#1e293b"/>
      
      <!-- Connected smaller gear -->
      <g transform="translate(120, 0)">
        <circle cx="0" cy="0" r="40" fill="#64748b" stroke="#3b82f6" stroke-width="3"/>
        <circle cx="0" cy="0" r="10" fill="#1e293b"/>
      </g>
    </g>
    
    <!-- Title text -->
    <g transform="translate(450, 180)">
      <text x="0" y="0" font-family="Arial, sans-serif" font-size="72" font-weight="bold" fill="#f8fafc">
        Brian Mechanisms
      </text>
      <text x="0" y="80" font-family="Arial, sans-serif" font-size="48" fill="#94a3b8">
        Interactive Mechanism Showcase
      </text>
      <text x="0" y="140" font-family="Arial, sans-serif" font-size="32" fill="#64748b">
        Explore 25+ advanced mechanical systems
      </text>
      <text x="0" y="190" font-family="Arial, sans-serif" font-size="24" fill="#3b82f6">
        • Quick Return Mechanisms • Rotary Motion • Walking Systems
      </text>
    </g>
  </g>
  
  <!-- Bottom branding -->
  <g transform="translate(50, 550)">
    <text font-family="Arial, sans-serif" font-size="24" fill="#64748b">
      © 2023-2024 Brian Mechanisms Robotics
    </text>
  </g>
</svg>